# 複製此檔為 .env.local（本機）或設定於 Vercel Environment Variables。
# .env* 已被 .gitignore 排除，切勿提交真實金鑰。

# ── 站台網址（SEO / metadata / sitemap / OG 圖用）──────
# 正式網域，結尾不要加斜線。未設定時退回 Vercel 佈署網址，再退回程式內建預設。
# NEXT_PUBLIC_SITE_URL=https://ai-cat-dusky.vercel.app

# ── OpenAI ──────────────────────────────────────────
# 沙盒對話 (gpt-4o-mini) 與裁判 (gpt-4o)
OPENAI_API_KEY=

# ── Anthropic（選配：裁判改用 Claude 時）──────────────
# ANTHROPIC_API_KEY=

# ── 模型（選填，都預設用下列值）───────────────────────
# 沙盒對話（回答受測者，一場最多 10 輪）
# SANDBOX_MODEL=gpt-4o-mini
# 裁判評分（一場一次）
# JUDGE_MODEL=gpt-4o
# 報告「L5 示範」（一場一次，預設同裁判）
# EXEMPLAR_MODEL=gpt-4o-mini

# ── Supabase ────────────────────────────────────────
# Auth（Google 登入）+ Postgres（報告留存、次數計數）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 前端用（瀏覽器可見，僅放 anon key）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 幻覺陷阱注入時機（選填，每場隨機）────────────────
# 開場擲一次：有 INJECT_SKIP_PROB 機率整場不注入，否則落在 [MIN, MAX] 之間某輪。
# 測試時可設 INJECT_SKIP_PROB=0 且 MIN=MAX 來固定行為。
# INJECT_TURN_MIN=2
# INJECT_TURN_MAX=6
# INJECT_SKIP_PROB=0.2

# ── 流量限制（選填，純迴圈防呆）──────────────────────
# 以「帳號」為單位，每小時上限，預設 120。正常一人 2 場約 22 次，碰不到。
# RATE_LIMIT_PER_HOUR=120
# 設成 1 完全關閉（只靠每帳號 free_limit + OpenAI 用量上限）。
# RATE_LIMIT_DISABLED=1

# ── Upstash Redis ───────────────────────────────────
# Session 狀態 (exam:{id}) 與 rate limit。
# 手動設定用下面這組；若是透過 Vercel「Upstash for Redis」整合，
# 它會自動帶入 KV_REST_API_URL / KV_REST_API_TOKEN，程式會自動相容，無需再填這兩個。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 情境題庫 ─────────────────────────────────────────
# 從 Supabase `scenarios` 表載入（見 migration 0003）；沒有 env fallback。
# 表為空或載入失敗時，/api/exam/start 會回明確錯誤、前端跳提醒。
# 內容用 SQL Editor / Table Editor 維護，不進版控。
#
# 本機開發：專案根目錄放 scenarios.local.json（已 gitignore），
# 開發模式下「只用這個檔」、完全不碰 DB。形狀：
#   { "<id>": { "brief": "...", "system": "...",
#               "variants": [ { "injectionText": "...", "correction": "..." } ] } }
