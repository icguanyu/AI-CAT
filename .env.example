# 複製此檔為 .env.local（本機）或設定於 Vercel Environment Variables。
# .env* 已被 .gitignore 排除，切勿提交真實金鑰。

# ── OpenAI ──────────────────────────────────────────
# 沙盒對話 (gpt-4o-mini) 與裁判 (gpt-4o)
OPENAI_API_KEY=

# ── Anthropic（選配：裁判改用 Claude 時）──────────────
# ANTHROPIC_API_KEY=

# ── Supabase ────────────────────────────────────────
# Auth（Google 登入）+ Postgres（報告留存、次數計數）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 前端用（瀏覽器可見，僅放 anon key）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Upstash Redis ───────────────────────────────────
# Session 狀態 (exam:{id}) 與 rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 情境題庫（機密！）────────────────────────────────
# 一段 JSON 字串，key 為 scenarioId，value 為 { brief, system, injectionText }。
# 實際內容不進版控，由 Vercel/Supabase Secret 或私有檔案注入。開發時可放 .env.local。
SCENARIOS_JSON={}
