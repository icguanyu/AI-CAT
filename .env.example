# 複製此檔為 .env.local（本機）或設定於 Vercel Environment Variables。
# .env* 已被 .gitignore 排除，切勿提交真實金鑰。

# ── OpenAI ──────────────────────────────────────────
# 沙盒對話 (gpt-4o-mini) 與裁判 (gpt-4o)
OPENAI_API_KEY=

# ── Anthropic（選配：裁判改用 Claude 時）──────────────
# ANTHROPIC_API_KEY=

# ── Supabase ────────────────────────────────────────
# Auth（Google 登入）+ Postgres（報告留存、次數計數）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 前端用（瀏覽器可見，僅放 anon key）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Upstash Redis ───────────────────────────────────
# Session 狀態 (exam:{id}) 與 rate limit。
# 手動設定用下面這組；若是透過 Vercel「Upstash for Redis」整合，
# 它會自動帶入 KV_REST_API_URL / KV_REST_API_TOKEN，程式會自動相容，無需再填這兩個。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 情境題庫（機密！）────────────────────────────────
# 一段 JSON 字串，key 為 scenarioId。每題支援多個隨機變體：
#   { "<id>": { "brief": "任務說明", "system": "沙盒模型 system",
#               "variants": [
#                 { "injectionText": "蓄意錯誤敘述 A", "correction": "正解（報告畫面顯示）" },
#                 { "injectionText": "蓄意錯誤敘述 B", "brief": "覆寫該場任務說明（選填）" }
#               ] } }
#   correction 選填：陷阱生效時，報告畫面會顯示「對話中出現 vs 正確資訊」對照。
# 舊格式 { brief, system, injectionText } 仍相容（自動轉成單一變體）。
# 實際內容不進版控，由 Vercel Secret 或 .env.local 注入。
SCENARIOS_JSON={}
